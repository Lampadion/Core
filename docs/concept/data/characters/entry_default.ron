// =====================================================================================
// ЭТАЛОН ЗАПИСИ (Symbol) — плоская разрешённая запись, аналог ChrEntry.data из старой программы.
//
// Это результат шага 3 пайплайна: все генераторы (members, matrix, referenced_matrix, generator),
// value_sequence, {шаблоны} и ${ссылки} уже развёрнуты, источник и приоритеты применены.
// Так выглядит ОДНА запись, например diacritic:acute. Объявления в RON-файлах (Entry + Source)
// раскрываются в такие записи.
//
// Хранилище записей — пары «полный id -> Symbol» (хэш-таблица). Id и пространство имён в самой записи
// НЕ хранятся: полный id является ключом, поэтому доступ к записи по id не требует обхода записей.
// Пространство имён входит в id; при необходимости выделяется разбором ключа до первого ':'.
//
// Обозначения:
//   [обяз.]       у записи нет разумного значения по умолчанию, его задаёт база
//   [= X]         значение по умолчанию X
//   [нет]         значения нет (Option::None)
//   [вычисл.]     вычисляет загрузчик, в файлах баз не пишется
//   [предложено]  поле, которого в концепте ещё нет или оно не подтверждено
//
// В записи НЕ хранится то, что даёт ICU: официальное имя, категория, скрипт, блок, версия Unicode,
// числовые ссылки (&#...;), числовое значение. GUI и поиск спрашивают это у ICU напрямую.
// =====================================================================================
{
	// Ключ: полный id. Формат "namespace:local_id"; у записи без пространства имён просто "local_id".
	// Зарезервированные символы: ':' (граница пространства имён) и '+' (граница компонентов состава).
	"namespace:local_id": Symbol(
		// ---- Служебное ----
		index: 0,                           // [вычисл.] u32. Позиция в развёрнутом файле (порядок показа в GUI)
		origin: (                           // [предложено] Для диагностики и режима patch
			file: "",                       //   String. Id файла, в котором объявлена запись
			source: Single,                 //   Single | Member | MatrixCell | ReferencedMatrix | PackedRange
		),

		// ---- Значение ----
		value: Cp(0x0000),                  // [обяз.] Value: Cp(u32) | Seq([u32]) | RawTxt(String). Chr при разборе стал Cp
		normalization: Preserve,            // [= Preserve] Preserve | Nfc | Nfd | Auto
		allow_multi_grapheme: false,        // [= false] bool
		normalized: [],                     // [вычисл.] Vec<char>. Нормализованная форма для сравнения и индексов
		                                    //   (исходная запись автора остаётся в value)

		// ---- Связи и видимость ----
		collections: [],                    // [= []] Vec<Collection>
		variation_of: None,                 // [нет] Полный id родителя
		variation: None,                    // [нет] Вид вариации из реестра (math_bold, circled, fullwidth, ...)
		composition: None,                  // [предложено] [нет] (base: полный id, marks: [полные id]). Только у составных записей,
		                                    //   например latin:c_letter_a+breve+acute. Поиск и GUI идут по этому полю, а не по id
		hidden: false,                      // [= false] bool

		// ---- Ввод ----
		recipes: [],                        // [= []] Vec<String>. Рецепты после подстановки шаблонов и ссылок
		binds: [],                          // [= []] Vec<Bind>. Привязки клавиш по режимам; одновременно отображаются в GUI и регистрируются
		                                    //   Структуру Bind см. в конце файла. target_entry в записи не хранится: это сама запись (ключ)

		// ---- Поиск и представления ----
		tags: [],                           // [= []] Vec<String>. Дополнительные поисковые токены; у большинства записей пусто:
		                                    //   теги создаются при инициализации общими правилами автогенерации (вне записи)
		// Заголовки (titles) зависят от языка и относятся к слою локализации; в запись пока не включены, формат не определён.
		repr: (
			html: [],                       // [= []] Vec<String>
			latex: [],                      // [= []] Vec<String>
		),

		// ---- GUI ----
		ui: (
			display_groups: [],             // [= []] Vec<(Tab, Vec<Group>)>. Только место записи в GUI; модификаторов группы не несут
		),

		// ---- Опции ----
		options: (
			layout_titles: false,           // [= false] bool
			layout_titles_as_main: false,   // [= false] bool
			font: None,                     // [нет] String
			apply_font_on_recipe_field: true, // [= true?] bool. Значение по умолчанию не определено, true предложено
		),
	),
}

// =====================================================================================
// ВЛОЖЕННЫЙ ЭТАЛОН: Bind (элемент поля binds)
//
// Bind(
//	mode: Default,          // [= Default] Default | Domain("Name") | IME("Name"); имена берутся из реестра (моды на Rune)
//	id: None,               // [нет] String. Адрес для переопределения в отдельных файлах: запись + id
//	key: Latin("A"),        // [обяз., кроме IME] InputKey: Latin("A") | Cyrillic("Ф") | Hellenic("α") | Physical("KeyA") | Custom("set", "key")
//	modifiers: [],          // [= []] Vec<Modifier>: Alt, LeftAlt, RightAlt, Control, LeftControl, RightControl,
//	                        //        Shift, LeftShift, RightShift, Super, LeftSuper, RightSuper (без стороны = любая)
//	locks: [],              // [= []] Vec<Lock>: CapsLock, NumLock, ScrollLock. Не указанный CapsLock означает «выключен»
//	input: [],              // [предложено] Vec<InputItem>. Только IME: элементы Latin("a") | Sym("полный id") вместо key
// )
//
// Приоритет при совпадении: явный бинд с Shift приоритетнее запасного поведения (Shift вводит то же, что включённый CapsLock);
// более конкретный бинд (со стороной) приоритетнее общего Shift. Подробно: раздел 8 концепта.
// =====================================================================================
