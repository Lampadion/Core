// =====================================================================================
// ЭТАЛОН ЗАПИСИ (редакция 2)
// Справочный файл: показывает ВСЕ поля записи, их типы и значения по умолчанию.
// Не входит в базу. По нему пишутся Rust-типы и проверяется парсер.
//
// Условные обозначения в комментариях:
//   [обяз.]       поле обязательно
//   [= X]         поле необязательно; при отсутствии берётся X (в Rust: #[serde(default)])
//   [нет]         поле необязательно; при отсутствии значения нет (Option::None)
//   {имя}         переменная участника или оси (шаблон)
//   ${id}         ссылка на запись; $$ литерал $; {{ и }} литеральные скобки
//
// Структура записи: Идентификация + Источник (ровно один) + Свойства (общие для всех источников).
//
// Приоритет значений свойства:
//   overrides > Member / ячейка матрицы > Entry > defaults файла > встроенное значение по умолчанию
//
// Инварианты (проверяются при загрузке):
//   1. Задано ровно одно из id / id_template.
//   2. Задан ровно один источник: value | members | matrix | referenced_matrix | generator.
//   3. members / matrix / referenced_matrix / generator требуют id_template.
//   4. value_sequence допустим только вместе с members.
//   5. Шаблонные {имя} подставляются первыми, ссылки ${id} после (когда все записи уже существуют).
//   6. Неизвестная переменная в шаблоне это ошибка загрузки. Неразрешённая ссылка ${id} даёт
//      предупреждение: рецепт пропускается, запись остаётся.
// =====================================================================================
(
	metadata: (
		id: "reference",                    // [обяз.] String. Уникальный id файла
		namespace: "reference",             // [обяз.] String. Пространство имён: полный id записи = namespace:id
		name: "Entry reference",            // [= id] String. Имя категории для GUI
		order: 0,                           // [= 0] i32. Порядок сортировки в GUI
		description: "",                    // [= ""] String
		schema_version: 2,                  // [обяз.?] u32. Предложено; нужно ли, это открытый вопрос
		requires: [],                       // [= []] Vec<String>. Id файлов, загружаемых раньше
		                                    //   (на них опираются короткие ссылки ${acute})

		// Предложено, не принято: значения по умолчанию файла для любых общих свойств записи.
		defaults: (
			// collections: [Diacritic],
			// ui: ( display_groups: [(Forge, [Diacritic])] ),
			// options: ( layout_titles: true ),
			// hidden: false,
			// normalization: Preserve,
		),
	),

	entries: [
		// ---------------------------------------------------------------------------------
		// ЭТАЛОННАЯ ЗАПИСЬ: все общие поля. Источник здесь value (тип 1); остальные источники ниже.
		// ---------------------------------------------------------------------------------
		Entry(
			// ---- Идентификация (ровно одно из id / id_template) ----
			id: "example",                      // [обяз., если нет id_template] Локальный id. Полный: reference:example
			// id_template: "ex_{kind}",        // [обяз., если нет id] Шаблон id; {имя} это переменная участника/оси
			// namespace: "other",              // [= metadata.namespace] Явное другое пространство имён

			// ---- Источник (ровно один) ----
			value: Cp(0x0301),                  // Value: Cp(u32) | Chr(char) | Seq([u32]) | RawTxt(String)
			                                    //   Сокращение: codepoint: 0x0301 == value: Cp(0x0301)

			// ---- Значение: нормализация и проверки ----
			normalization: Preserve,            // [= Preserve] Preserve | Nfc | Nfd | Auto
			allow_multi_grapheme: false,        // [= false] bool. Для RawTxt проверка графем не выполняется

			// ---- Связи и видимость ----
			collections: [],                    // [= []] Vec<Collection>. Пример: [Diacritic]
			// variation_of: "ns:parent_id",    // [нет] String. Полный id родителя; допускает шаблон ("latin:lat_{case}_letter_{letter}")
			hidden: false,                      // [= false] bool. Не показывать в основных списках GUI

			// ---- Ввод ----
			recipes: [],                        // [= []] Vec<String>. Рецепт: строка с шаблонами. Пример: ["A${diacritic:acute}", "AE"]
			// alt_layout_key: "<! {key}",      // [нет] String. Клавиша режима альтернативного ввода (старая нотация модификаторов)

			// ---- Поиск и представления ----
			tags: [],                           // [= []] Vec<String>. Дополнительные поисковые токены (то, чего нет в ICU)
			repr: (                             // Представления, которых нет в ICU. Формат не обсуждался подробно
				html: [],                       //   [= []] Vec<String>. Имена сущностей. Пример: ["Abreve"]
				latex: [],                      //   [= []] Vec<String>. Пример: ["\\breve{A}"]
			),

			// ---- GUI (ядро от него не зависит) ----
			ui: (
				display_groups: [],             // [= []] Vec<(Tab, Vec<Group>)>. Пример: [(Forge, [Diacritic]), (FastKeys, [DiacriticPrimary])]
			),

			// ---- Прочие опции ----
			options: (
				fast_key: [],                   // [= []] Vec<InputKey>. Пример: [Latin("A"), Cyrillic("Ф"), Hellenic("α")]
				layout_titles: false,           // [= false] bool
				layout_titles_as_main: false,   // [= false] bool
				// font: "Noto Sans Symbols 2", // [нет] String. Шрифт для отображения символа
				apply_font_on_recipe_field: true, // [= true?] bool. Значение по умолчанию не определено, true предложено
			),
		),

		// ---------------------------------------------------------------------------------
		// ИСТОЧНИК: members (типы 2 и 3). Список участников; Member определяет локальные поля.
		// Тип 2: есть variation_of. Тип 3: variation_of нет.
		// ---------------------------------------------------------------------------------
		Entry(
			id_template: "ex_tone_{level}",
			// variation_of: "ns:parent_{level}",       // Тип 2. Допускает {переменные участника}

			// Последовательные значения. Значение участника = start + индекс_в_members * step.
			value_sequence: (
				start: Cp(0x02E5),                      // [обяз.] Только Cp
				step: 1,                                // [= 1] i32. Минус задаёт обратный порядок, 2 даёт «через один»
			),

			// Шаблонные свойства: любые строковые значения свойств записи могут содержать {имя}.
			recipes: ["tn {abbr}"],
			alt_layout_key: "<! {key}",

			// Общие свойства записи (collections, hidden, ui, options, ...) действуют для всех участников.
			members: [
				Member(
					level: "high",                      // Переменные участника: любое поле, не являющееся свойством записи
					abbr: "h",
					key: "8",
					// value: Cp(0x02E6),               // [нет] Value. Побеждает value_sequence; остальные участники не сдвигаются
					// recipes: ["tn hh"],              // Любое общее свойство записи. Полностью заменяет шаблон записи
				),
			],
		),

		// ---------------------------------------------------------------------------------
		// ИСТОЧНИК: matrix (тип 4). Декартова сетка осей + правило вычисления.
		// Тип 5: ячейки могут задавать значение через Fixed(...) / Computed(...).
		// ---------------------------------------------------------------------------------
		// Примечание для парсера: оси записаны ключами-строками внутри (...). Для serde это может
		// потребовать формы { "axis": [...] } или списка пар (имя, элементы); порядок осей фиксирован.
		Entry(
			id_template: "ex_{case}_letter_{letter}",
			matrix: (
				"letter": [                             // Ось: Vec<элемент>. Порядок задан и детерминирован
					(id: "a", offset: 0),               // id: [обяз.] String. offset: i64. Любые другие поля становятся переменными {имя}
					(id: "b", offset: 1),
				],
				"case": [
					(id: "upper", start_codepoint: 0x0041),   // start_codepoint: u32
					(id: "lower", start_codepoint: 0x0061),
				],
				// Тип 5: элемент оси может нести значение явно или вычисляемо.
				// Member(id: "c", value: Fixed(Cp(0xA766))),
				// Member(id: "s", value: Computed(base: "ns:id_of_base", mod: "diacritic:acute")),
			),
			calculation_rule: (                         // [= start_codepoint + offset]
				codepoint: "start_codepoint + offset",  // Выражение над полями элементов осей
			),
			overrides: [                                // [= []] Переопределения отдельных ячеек
				(cell: ("case": "lower", "letter": "b"), value: Cp(0x212C)),   // Любые свойства: value, recipes, fast_key, ...
			],
			exclude: [                                  // [= []] Несуществующие комбинации
				("case": "upper", "letter": "z"),
			],
		),

		// ---------------------------------------------------------------------------------
		// ИСТОЧНИК: referenced_matrix (тип 6). Сборка по ссылкам на уже существующие записи.
		// ---------------------------------------------------------------------------------
		Entry(
			id_template: "ex_{case}_letter_a_with_{accent}",
			referenced_matrix: (
				"base": (                               // Имя роли, доступно как ${base} в merging_rules
					entry_id_pattern: "latin:lat_{case}_letter_a",   // Полный id или паттерн с переменными / пространством имён
					variables: ["case"],                // Переменные, которые пробрасываются в id_template (join по пересечению)
					// filter: (collections: [Diacritic], hidden: false),   // [нет] Отбор записей
				),
				"modifier": (
					entry_id_pattern: "diacritic:{accent}",          // Всё пространство имён diacritic
					variables: ["accent"],
					filter: (collections: [Diacritic], hidden: false),
				),
			),
			merging_rules: (
				recipes: Template(["${base}${modifier}"]),           // Template([String]) | Append(from: [роль, ...])
				value: Compose(                                      // Результат: Precomposed(char) | Sequence(Vec<char>)
					normalization: Nfc,                              // [= Nfc] Preserve | Nfc | Nfd | Auto
					on_unresolved: Skip,                             // [= Skip] Skip | KeepSequence | Error
				),
			),
		),

		// ---------------------------------------------------------------------------------
		// ИСТОЧНИК: generator (тип 7). Сегментированная запись с разрывами в Unicode.
		// ---------------------------------------------------------------------------------
		Entry(
			id_template: "ex_sign_{index}",
			generator: PackedRange(
				total_count: 20,                                     // Логические индексы 0..19
				unicode_spans: [
					(index_start: 0,  index_end: 14, codepoint_start: 0x1BF0),
					(index_start: 15, index_end: 19, codepoint_start: 0xA800),
				],
			),
		),
	],
)

// =====================================================================================
// СПРАВОЧНИК ТИПОВ
// =====================================================================================
//
// Value (результат записи):
//   Cp(u32)            один code point; число остаётся доступным; проверка диапазона и суррогатов при загрузке
//   Chr(char)          литерал, приводится к Cp
//   Seq([u32])         последовательность code points (combining, ZWJ, variation selectors, Regional Indicators, Tags)
//   RawTxt(String)     строка как есть; без нормализации и проверки графем
//   Fixed(Value)       только в ячейках матрицы: готовое значение
//   Computed(base, mod) только в ячейках матрицы: вычисление; результат Precomposed | Sequence
//
// Нормализация:        Preserve | Nfc | Nfd | Auto   (Auto: NFC, если схлопывается в один символ, иначе Seq)
//
// Открытые перечисления (в данных записываются идентификаторами; у каждого есть Custom("id"),
// заполняемый реестром модов на Rune):
//   Collection         Diacritic, Cyrillic, Special, ...
//   Tab                Forge, FastKeys, ...
//   Group              Diacritic, DiacriticPrimary, Special, ...
//   InputKey           Latin("A"), Cyrillic("Ф"), Hellenic("α"), Custom("set_id", "key")
//                      Значение в скобках это реальный символ набора, логический идентификатор клавиши
//
// Ссылки на записи:
//   полная форма       ${namespace:id}
//   короткая форма     ${id}: сначала пространство имён текущего файла, затем файлы из requires;
//                      неоднозначность это ошибка загрузки
//
// Пайплайн загрузки:
//   Declaration -> развёртывание (members, matrix, referenced_matrix, generator; тип 6 по графу зависимостей;
//   затем value_sequence и {имя}, после них ${id}) -> Symbol (плоская разрешённая запись) ->
//   валидация (дубли id и значений, непризначенные code points, графемы, ссылки, циклы) -> индексы
//   (по id, по нормализованному значению, по токенам поиска, по рецептам).
