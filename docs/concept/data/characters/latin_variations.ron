(
	metadata: (
		id: "latin_variations",
		namespace: "latin",
		name: "Latin Variations",
		order: 2,
		description: "Unicode-вариации латинских букв a-z / A-Z (математические алфавиты, fullwidth, circled и др.)",
		schema_version: 2,
		requires: ["latin_cocept"], // Родители вариаций (latin:lat_{case}_letter_{letter}) создаются матрицей из latin_cocept
	),

	entries: [
		// ---------------------------------------------------------------------------------
		// Регулярные наборы: одна матрица на все 26 букв обоих регистров.
		// Явно заданы только стартовые кодовые точки каждой формы (регистр + вид вариации),
		// остальное считает calculation_rule. Родитель берётся шаблонным variation_of.
		// ---------------------------------------------------------------------------------
		Entry(
			id_template: "lat_{case}_letter_{letter}_{variation}",
			variation_of: "latin:lat_{case}_letter_{letter}",
			hidden: true,

			matrix: (
				"letter": [
					(id: "a", offset: 0)  (id: "b", offset: 1)  (id: "c", offset: 2),
					(id: "d", offset: 3)  (id: "e", offset: 4)  (id: "f", offset: 5),
					(id: "g", offset: 6)  (id: "h", offset: 7)  (id: "i", offset: 8),
					(id: "j", offset: 9)  (id: "k", offset: 10)  (id: "l", offset: 11),
					(id: "m", offset: 12)  (id: "n", offset: 13)  (id: "o", offset: 14),
					(id: "p", offset: 15)  (id: "q", offset: 16)  (id: "r", offset: 17),
					(id: "s", offset: 18)  (id: "t", offset: 19)  (id: "u", offset: 20),
					(id: "v", offset: 21)  (id: "w", offset: 22)  (id: "x", offset: 23),
					(id: "y", offset: 24)  (id: "z", offset: 25),
				],

				// Форма = регистр + вид вариации. Набор форм у регистров разный (regional_indicator, outlined и др. есть только у заглавных).
				"form": [
					(id: "math_italic_upper",                 case: "upper", variation: "math_italic",                 start_codepoint: 0x1D434),
					(id: "math_italic_bold_upper",            case: "upper", variation: "math_italic_bold",            start_codepoint: 0x1D468),
					(id: "math_bold_upper",                   case: "upper", variation: "math_bold",                   start_codepoint: 0x1D400),
					(id: "math_fraktur_upper",                case: "upper", variation: "math_fraktur",                start_codepoint: 0x1D504),
					(id: "math_fraktur_bold_upper",           case: "upper", variation: "math_fraktur_bold",           start_codepoint: 0x1D56C),
					(id: "math_script_upper",                 case: "upper", variation: "math_script",                 start_codepoint: 0x1D49C),
					(id: "math_script_bold_upper",            case: "upper", variation: "math_script_bold",            start_codepoint: 0x1D4D0),
					(id: "math_double_struck_upper",          case: "upper", variation: "math_double_struck",          start_codepoint: 0x1D538),
					(id: "math_sans_serif_upper",             case: "upper", variation: "math_sans_serif",             start_codepoint: 0x1D5A0),
					(id: "math_sans_serif_italic_upper",      case: "upper", variation: "math_sans_serif_italic",      start_codepoint: 0x1D608),
					(id: "math_sans_serif_italic_bold_upper", case: "upper", variation: "math_sans_serif_italic_bold", start_codepoint: 0x1D63C),
					(id: "math_sans_serif_bold_upper",        case: "upper", variation: "math_sans_serif_bold",        start_codepoint: 0x1D5D4),
					(id: "math_monospace_upper",              case: "upper", variation: "math_monospace",              start_codepoint: 0x1D670),
					(id: "fullwidth_upper",                   case: "upper", variation: "fullwidth",                   start_codepoint: 0xFF21),
					(id: "circled_upper",                     case: "upper", variation: "circled",                     start_codepoint: 0x24B6),
					(id: "negative_circled_upper",            case: "upper", variation: "negative_circled",            start_codepoint: 0x1F150),
					(id: "squared_upper",                     case: "upper", variation: "squared",                     start_codepoint: 0x1F130),
					(id: "negative_squared_upper",            case: "upper", variation: "negative_squared",            start_codepoint: 0x1F170),
					(id: "regional_indicator_upper",          case: "upper", variation: "regional_indicator",          start_codepoint: 0x1F1E6),
					(id: "parenthesized_upper",               case: "upper", variation: "parenthesized",               start_codepoint: 0x1F110),
					(id: "tag_upper",                         case: "upper", variation: "tag",                         start_codepoint: 0xE0041),
					(id: "outlined_upper",                    case: "upper", variation: "outlined",                    start_codepoint: 0x1CCD6),

					(id: "math_italic_lower",                 case: "lower", variation: "math_italic",                 start_codepoint: 0x1D44E),
					(id: "math_italic_bold_lower",            case: "lower", variation: "math_italic_bold",            start_codepoint: 0x1D482),
					(id: "math_bold_lower",                   case: "lower", variation: "math_bold",                   start_codepoint: 0x1D41A),
					(id: "math_fraktur_lower",                case: "lower", variation: "math_fraktur",                start_codepoint: 0x1D51E),
					(id: "math_fraktur_bold_lower",           case: "lower", variation: "math_fraktur_bold",           start_codepoint: 0x1D586),
					(id: "math_script_lower",                 case: "lower", variation: "math_script",                 start_codepoint: 0x1D4B6),
					(id: "math_script_bold_lower",            case: "lower", variation: "math_script_bold",            start_codepoint: 0x1D4EA),
					(id: "math_double_struck_lower",          case: "lower", variation: "math_double_struck",          start_codepoint: 0x1D552),
					(id: "math_sans_serif_lower",             case: "lower", variation: "math_sans_serif",             start_codepoint: 0x1D5BA),
					(id: "math_sans_serif_italic_lower",      case: "lower", variation: "math_sans_serif_italic",      start_codepoint: 0x1D622),
					(id: "math_sans_serif_italic_bold_lower", case: "lower", variation: "math_sans_serif_italic_bold", start_codepoint: 0x1D656),
					(id: "math_sans_serif_bold_lower",        case: "lower", variation: "math_sans_serif_bold",        start_codepoint: 0x1D5EE),
					(id: "math_monospace_lower",              case: "lower", variation: "math_monospace",              start_codepoint: 0x1D68A),
					(id: "fullwidth_lower",                   case: "lower", variation: "fullwidth",                   start_codepoint: 0xFF41),
					(id: "circled_lower",                     case: "lower", variation: "circled",                     start_codepoint: 0x24D0),
					(id: "parenthesized_lower",               case: "lower", variation: "parenthesized",               start_codepoint: 0x249C),
					(id: "tag_lower",                         case: "lower", variation: "tag",                         start_codepoint: 0xE0061),
				],
			),

			calculation_rule: (
				codepoint: "start_codepoint + offset"
			),

			// Дыры Unicode: в блоке Mathematical Alphanumeric Symbols часть кодовых точек зарезервирована,
			// а буквы живут в Letterlike Symbols (U+2100..214F).
			overrides: [
				(cell: ("form": "math_script_upper", "letter": "b"), value: Cp(0x212C)),
				(cell: ("form": "math_script_upper", "letter": "e"), value: Cp(0x2130)),
				(cell: ("form": "math_script_upper", "letter": "f"), value: Cp(0x2131)),
				(cell: ("form": "math_script_upper", "letter": "h"), value: Cp(0x210B)),
				(cell: ("form": "math_script_upper", "letter": "i"), value: Cp(0x2110)),
				(cell: ("form": "math_script_upper", "letter": "l"), value: Cp(0x2112)),
				(cell: ("form": "math_script_upper", "letter": "m"), value: Cp(0x2133)),
				(cell: ("form": "math_script_upper", "letter": "r"), value: Cp(0x211B)),
				(cell: ("form": "math_script_lower", "letter": "e"), value: Cp(0x212F)),
				(cell: ("form": "math_script_lower", "letter": "g"), value: Cp(0x210A)),
				(cell: ("form": "math_script_lower", "letter": "o"), value: Cp(0x2134)),
				(cell: ("form": "math_fraktur_upper", "letter": "c"), value: Cp(0x212D)),
				(cell: ("form": "math_fraktur_upper", "letter": "h"), value: Cp(0x210C)),
				(cell: ("form": "math_fraktur_upper", "letter": "i"), value: Cp(0x2111)),
				(cell: ("form": "math_fraktur_upper", "letter": "r"), value: Cp(0x211C)),
				(cell: ("form": "math_fraktur_upper", "letter": "z"), value: Cp(0x2128)),
				(cell: ("form": "math_double_struck_upper", "letter": "c"), value: Cp(0x2102)),
				(cell: ("form": "math_double_struck_upper", "letter": "h"), value: Cp(0x210D)),
				(cell: ("form": "math_double_struck_upper", "letter": "n"), value: Cp(0x2115)),
				(cell: ("form": "math_double_struck_upper", "letter": "p"), value: Cp(0x2119)),
				(cell: ("form": "math_double_struck_upper", "letter": "q"), value: Cp(0x211A)),
				(cell: ("form": "math_double_struck_upper", "letter": "r"), value: Cp(0x211D)),
				(cell: ("form": "math_double_struck_upper", "letter": "z"), value: Cp(0x2124)),
				(cell: ("form": "math_italic_lower", "letter": "h"), value: Cp(0x210E)),
			],
		),

		// ---------------------------------------------------------------------------------
		// Нерегулярные наборы: кодовые точки не образуют сетку, поэтому это списки members.
		// Родитель задаётся шаблонным variation_of через переменную участника {letter}.
		// Букв, которых нет в Unicode для данного вида, в списках просто нет.
		// ---------------------------------------------------------------------------------
		// Modifier letter capital (ᴬ)
		Entry(
			id_template: "lat_upper_letter_{letter}_modifier",
			variation_of: "latin:lat_upper_letter_{letter}",
			hidden: true,
			members: [
				Member(letter: "a", value: Cp(0x1D2C)),
				Member(letter: "b", value: Cp(0x1D2E)),
				Member(letter: "c", value: Cp(0xA7F2)),
				Member(letter: "d", value: Cp(0x1D30)),
				Member(letter: "e", value: Cp(0x1D31)),
				Member(letter: "f", value: Cp(0xA7F3)),
				Member(letter: "g", value: Cp(0x1D33)),
				Member(letter: "h", value: Cp(0x1D34)),
				Member(letter: "i", value: Cp(0x1D35)),
				Member(letter: "j", value: Cp(0x1D36)),
				Member(letter: "k", value: Cp(0x1D37)),
				Member(letter: "l", value: Cp(0x1D38)),
				Member(letter: "m", value: Cp(0x1D39)),
				Member(letter: "n", value: Cp(0x1D3A)),
				Member(letter: "o", value: Cp(0x1D3C)),
				Member(letter: "p", value: Cp(0x1D3E)),
				Member(letter: "q", value: Cp(0xA7F4)),
				Member(letter: "r", value: Cp(0x1D3F)),
				Member(letter: "t", value: Cp(0x1D40)),
				Member(letter: "u", value: Cp(0x1D41)),
				Member(letter: "v", value: Cp(0x2C7D)),
				Member(letter: "w", value: Cp(0x1D42)),
			],
		),

		// Modifier letter small (ᵃ); для i и n это superscript-формы U+2071 и U+207F
		Entry(
			id_template: "lat_lower_letter_{letter}_modifier",
			variation_of: "latin:lat_lower_letter_{letter}",
			hidden: true,
			members: [
				Member(letter: "a", value: Cp(0x1D43)),
				Member(letter: "b", value: Cp(0x1D47)),
				Member(letter: "c", value: Cp(0x1D9C)),
				Member(letter: "d", value: Cp(0x1D48)),
				Member(letter: "e", value: Cp(0x1D49)),
				Member(letter: "f", value: Cp(0x1DA0)),
				Member(letter: "g", value: Cp(0x1D4D)),
				Member(letter: "h", value: Cp(0x02B0)),
				Member(letter: "i", value: Cp(0x2071)),
				Member(letter: "j", value: Cp(0x02B2)),
				Member(letter: "k", value: Cp(0x1D4F)),
				Member(letter: "l", value: Cp(0x02E1)),
				Member(letter: "m", value: Cp(0x1D50)),
				Member(letter: "n", value: Cp(0x207F)),
				Member(letter: "o", value: Cp(0x1D52)),
				Member(letter: "p", value: Cp(0x1D56)),
				Member(letter: "q", value: Cp(0x107A5)),
				Member(letter: "r", value: Cp(0x02B3)),
				Member(letter: "s", value: Cp(0x02E2)),
				Member(letter: "t", value: Cp(0x1D57)),
				Member(letter: "u", value: Cp(0x1D58)),
				Member(letter: "v", value: Cp(0x1D5B)),
				Member(letter: "w", value: Cp(0x02B7)),
				Member(letter: "x", value: Cp(0x02E3)),
				Member(letter: "y", value: Cp(0x02B8)),
				Member(letter: "z", value: Cp(0x1DBB)),
			],
		),

		// Small capital (ᴀ); как и в старой базе, привязана к заглавной букве
		Entry(
			id_template: "lat_upper_letter_{letter}_small_capital",
			variation_of: "latin:lat_upper_letter_{letter}",
			hidden: true,
			members: [
				Member(letter: "a", value: Cp(0x1D00)),
				Member(letter: "b", value: Cp(0x0299)),
				Member(letter: "c", value: Cp(0x1D04)),
				Member(letter: "d", value: Cp(0x1D05)),
				Member(letter: "e", value: Cp(0x1D07)),
				Member(letter: "f", value: Cp(0xA730)),
				Member(letter: "g", value: Cp(0x0262)),
				Member(letter: "h", value: Cp(0x029C)),
				Member(letter: "i", value: Cp(0x026A)),
				Member(letter: "j", value: Cp(0x1D0A)),
				Member(letter: "k", value: Cp(0x1D0B)),
				Member(letter: "l", value: Cp(0x029F)),
				Member(letter: "m", value: Cp(0x1D0D)),
				Member(letter: "n", value: Cp(0x0274)),
				Member(letter: "o", value: Cp(0x1D0F)),
				Member(letter: "p", value: Cp(0x1D18)),
				Member(letter: "q", value: Cp(0xA7AF)),
				Member(letter: "r", value: Cp(0x0280)),
				Member(letter: "s", value: Cp(0xA731)),
				Member(letter: "t", value: Cp(0x1D1B)),
				Member(letter: "u", value: Cp(0x1D1C)),
				Member(letter: "v", value: Cp(0x1D20)),
				Member(letter: "w", value: Cp(0x1D21)),
				Member(letter: "y", value: Cp(0x028F)),
				Member(letter: "z", value: Cp(0x1D22)),
			],
		),

		// Subscript (ₐ)
		Entry(
			id_template: "lat_lower_letter_{letter}_subscript",
			variation_of: "latin:lat_lower_letter_{letter}",
			hidden: true,
			members: [
				Member(letter: "a", value: Cp(0x2090)),
				Member(letter: "e", value: Cp(0x2091)),
				Member(letter: "h", value: Cp(0x2095)),
				Member(letter: "i", value: Cp(0x1D62)),
				Member(letter: "j", value: Cp(0x2C7C)),
				Member(letter: "k", value: Cp(0x2096)),
				Member(letter: "l", value: Cp(0x2097)),
				Member(letter: "m", value: Cp(0x2098)),
				Member(letter: "n", value: Cp(0x2099)),
				Member(letter: "o", value: Cp(0x2092)),
				Member(letter: "p", value: Cp(0x209A)),
				Member(letter: "r", value: Cp(0x1D63)),
				Member(letter: "s", value: Cp(0x209B)),
				Member(letter: "t", value: Cp(0x209C)),
				Member(letter: "u", value: Cp(0x1D64)),
				Member(letter: "v", value: Cp(0x1D65)),
				Member(letter: "x", value: Cp(0x2093)),
			],
		),

		// Combining latin small letter (ͣ)
		Entry(
			id_template: "lat_lower_letter_{letter}_combining",
			variation_of: "latin:lat_lower_letter_{letter}",
			hidden: true,
			members: [
				Member(letter: "a", value: Cp(0x0363)),
				Member(letter: "b", value: Cp(0x1DE8)),
				Member(letter: "c", value: Cp(0x0368)),
				Member(letter: "d", value: Cp(0x0369)),
				Member(letter: "e", value: Cp(0x0364)),
				Member(letter: "f", value: Cp(0x1DEB)),
				Member(letter: "g", value: Cp(0x1DDA)),
				Member(letter: "h", value: Cp(0x036A)),
				Member(letter: "i", value: Cp(0x0365)),
				Member(letter: "k", value: Cp(0x1DDC)),
				Member(letter: "l", value: Cp(0x1DDD)),
				Member(letter: "m", value: Cp(0x036B)),
				Member(letter: "n", value: Cp(0x1DE0)),
				Member(letter: "o", value: Cp(0x0366)),
				Member(letter: "p", value: Cp(0x1DEE)),
				Member(letter: "r", value: Cp(0x036C)),
				Member(letter: "s", value: Cp(0x1DE4)),
				Member(letter: "t", value: Cp(0x036D)),
				Member(letter: "u", value: Cp(0x0367)),
				Member(letter: "v", value: Cp(0x036E)),
				Member(letter: "w", value: Cp(0x1DF1)),
				Member(letter: "x", value: Cp(0x036F)),
				Member(letter: "z", value: Cp(0x1DE6)),
			],
		),
	],
)
