(
		metadata: (
				id: "diacritic",
				name: "Diacritic Marks",
				order: 1,
				description: "Diacritic marks and related characters",
		),

		entries: [
				Entry(
					id: "acute",
					codepoint: 0x0301,
					collections: [Diacritic], // Use ENUM
					ui: (display_groups: [
						(Forge, [Diacritic])
						(FastKeys, [DiacriticPrimary])
						]), // Use ENUM
					options: (
						fast_key: "A Ф",
					),
				),
				Entry(
					id_template: "acute_{variation}",
					hidden: true,
					variation_of: "acute",
					collections: [Diacritic],

					members: [
						Member(variation: "uncombined", codepoint: 0x00B4),
						Member(variation: "modifier", codepoint: 0x02CA),
					],
				)
		],
)


