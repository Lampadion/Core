(
    metadata: (
        id: "diacritic",
        name: "Diacritic Marks",
        order: 1,
        description: "Diacritic marks and related characters",
    ),

    entries: [
				Entry(
					id: "acute",
					unicode: "0301",
					collections: [Diacritic], // Use ENUM
					ui: (display_groups: [DiacriticPrimary]), // Use ENUM
					options: (
						fast_key: "A Ф",
					),
				),
				Entry(
					id_template: "acute_{variation}",
					hidden: true,
					variation_of: "acute",
					collections: [Diacritic],

					members: [
						Member(variation: "uncombined", unicode: "00B4"),
						Member(variation: "modifier", unicode: "02CA"),
					],
				)
		],
)


