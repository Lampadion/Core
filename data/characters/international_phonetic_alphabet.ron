						),
						members: [
								Member(level: "extra_high", codepoint: 0xA70D, recipe: ["tndl eh"], alt_layout_key: "c*>!<! 7"),
								Member(level: "high",       codepoint: 0xA70E, recipe: ["tndl h"],  alt_layout_key: "c*>!<! 8"),
								Member(level: "mid",        codepoint: 0xA70F, recipe: ["tndl m"],  alt_layout_key: "c*>!<! 9"),
