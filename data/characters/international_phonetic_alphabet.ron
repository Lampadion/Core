(
		metadata: (
				id: "ipa",
				name: "International Phonetic Alphabet",
				order: 20015,
				description: "Tone bars and related IPA extensions",
		),

		entries: [
				Entry(
						id_template: "ipa_n_let_tone_bar_{level}",
						options: (
								layout_titles: true,
								layout_titles_as_main: true,
						),
						members: [
								Member(level: "extra_high", codepoint: 0x02E5, recipe: ["tn eh"], alt_layout_key: Some("<! 7")),
								Member(level: "high",       codepoint: 0x02E6, recipe: ["tn h"],  alt_layout_key: Some("<! 8")),
								Member(level: "mid",        codepoint: 0x02E7, recipe: ["tn m"],  alt_layout_key: Some("<! 9")),
								Member(level: "low",        codepoint: 0x02E8, recipe: ["tn l"],  alt_layout_key: Some("<! 0")),
								Member(level: "extra_low",  codepoint: 0x02E9, recipe: ["tn el"], alt_layout_key: Some("<! -")),
						],
				),

				Entry(
						id_template: "ipa_n_let_tone_bar_{level}_left_stem",
						options: (
								layout_titles: true,
								layout_titles_as_main: true,
						),
						members: [
								Member(level: "extra_high", codepoint: 0xA712, recipe: ["tnl eh"], alt_layout_key: "c*<! 7"),
								Member(level: "high",       codepoint: 0xA713, recipe: ["tnl h"],  alt_layout_key: "c*<! 8"),
								Member(level: "mid",        codepoint: 0xA714, recipe: ["tnl m"],  alt_layout_key: "c*<! 9"),
								Member(level: "low",        codepoint: 0xA715, recipe: ["tnl l"],  alt_layout_key: "c*<! 0"),
								Member(level: "extra_low",  codepoint: 0xA716, recipe: ["tnl el"], alt_layout_key: "c*<! -"),
						],
				),

				Entry(
						id_template: "ipa_n_let_tone_bar_{level}_dotted",
						options: (
								layout_titles: true,
								layout_titles_as_main: true,
						),
						members: [
								Member(level: "extra_high", codepoint: 0xA708, recipe: ["tnd eh"], alt_layout_key: ">!<! 7"),
								Member(level: "high",       codepoint: 0xA709, recipe: ["tnd h"],  alt_layout_key: ">!<! 8"),
								Member(level: "mid",        codepoint: 0xA70A, recipe: ["tnd m"],  alt_layout_key: ">!<! 9"),
								Member(level: "low",        codepoint: 0xA70B, recipe: ["tnd l"],  alt_layout_key: ">!<! 0"),
								Member(level: "extra_low",  codepoint: 0xA70C, recipe: ["tnd el"], alt_layout_key: ">!<! -"),
